{
	"name": "spectra",
	"version": "1.4.0",
	"private": true,
	"type": "module",
	"description": "SPECTRA - The Audio & Video Enhancement Extension",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build --output-logs=new-only",
		"typecheck": "turbo run typecheck",
		"lint": "turbo run lint"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"chrome-types": "^0.1.327",
		"sharp": "^0.34.5",
		"turbo": "2.10.5",
		"typescript": "^5.3.0"
	},
	"overrides": {
		"basic-ftp": "5.3.1",
		"chrome-types": "^0.1.327",
		"ip-address": "10.2.0",
		"js-yaml": "4.3.0",
		"ws": "8.21.1"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/features/*"
