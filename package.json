{
	"name": "nexus",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Project NEXUS - Chrome Extension Ecosystem (SPECTRA,  HALO)",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build --output-logs=new-only",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"verify:q": "bun scripts/verify-architecture.js -q",
		"verify:v": "bun scripts/verify-architecture.js -v",
		"generate-registry": "bun scripts/generate-tool-registry.mjs"
	},
	"devDependencies": {
		"chrome-types": "^0.1.327",
		"sharp": "^0.34.5",
		"turbo": "^2.0.0",
		"typescript": "^5.3.0"
	},
	"packageManager": "pnpm@10.0.0",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/features/*"
	],
	"engines": {
		"node": ">=18"
	}
}
