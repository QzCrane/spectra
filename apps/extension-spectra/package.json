{
	"name": "@nexus/extension-spectra",
	"version": "1.2.1",
	"private": true,
	"description": "SPECTRA - The Audio & Video Enhancement Extension",
	"type": "module",
	"scripts": {
		"dev": "bun build.mjs --watch",
		"build": "bun build.mjs --dev",
		"build:prod": "bun build.mjs",
		"build:copy": "powershell -Command \"Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; Copy-Item -Recurse public dist\"",
		"test:e2e": "bun build ; bun test/smoke.spec.ts",
		"test:volume": "bun build ; bun test/verify-volume.spec.ts",
		"typecheck": "bun tsc --noEmit"
	},
	"dependencies": {
		"@nexus/audio-engine": "workspace:*",
		"@nexus/kernel": "workspace:*",
		"peerjs": "^1.5.5",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@types/puppeteer": "^7.0.4",
		"@types/qrcode": "^1.5.6",
		"chrome-types": "^0.1.327",
		"esbuild": "^0.21.5",
		"puppeteer": "^24.34.0",
		"sharp": "^0.34.5",
		"tsx": "^4.21.0",
		"typescript": "^5.3.0"
	}
}