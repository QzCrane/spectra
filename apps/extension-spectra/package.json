{
	"name": "@nexus/extension-spectra",
	"version": "1.4.1",
	"private": true,
	"description": "SPECTRA - The Audio & Video Enhancement Extension",
	"type": "module",
	"scripts": {
		"dev": "bun build.mjs --watch --dev",
		"build": "bun build.mjs",
		"build:prod": "bun run build",
		"build:dev": "bun build.mjs --dev",
		"build:sourcemap": "bun build.mjs --sourcemap",
		"build:analyze": "bun build.mjs --analyze",
		"integrity": "bun scripts/check-production-artifacts.mjs",
		"typecheck": "bun tsc --noEmit",
		"lint": "biome check src public build.mjs scripts --max-diagnostics=100"
	},
	"dependencies": {
		"@nexus/audio-engine": "workspace:*",
		"@nexus/kernel": "workspace:*",
		"peerjs": "^1.5.5",
		"uqr": "^0.1.3"
	},
	"devDependencies": {
		"chrome-types": "^0.1.327",
		"esbuild": "^0.27.2",
		"sharp": "0.35.3",
		"terser": "5.43.1",
		"typescript": "^5.3.0"
	}
}
