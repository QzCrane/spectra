{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
		"paths": {
			"@nexus/contracts": ["packages/contracts/src"],
		"@nexus/contracts/bootstrap": ["packages/contracts/src/spectra.bootstrap.ts"],
		"@nexus/contracts/ui-runtime": ["packages/contracts/src/spectra.ui-runtime.ts"],
		"@nexus/contracts/ui-settings-runtime": ["packages/contracts/src/spectra.ui-settings-runtime.ts"],
		"@nexus/contracts/content-runtime": ["packages/contracts/src/spectra.content-runtime.ts"],
      "@nexus/kernel": ["packages/nexus-kernel/src"],
      "@nexus/ui-kit": ["packages/ui-kit/src"],
      "@nexus/audio-engine": ["packages/features/audio-engine/src"]
    },
    "types": ["chrome-types"]
  },
  "exclude": ["node_modules", "dist"]
}
