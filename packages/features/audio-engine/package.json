{
	"name": "@nexus/audio-engine",
	"version": "0.0.1",
	"private": true,
	"description": "SPECTRA Audio Engine - WebAudio Controller & Policy Engine",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./*": null
	},
	"scripts": {
		"build": "bun tsc",
		"dev": "bun tsc --watch",
		"lint": "biome check src --max-diagnostics=100",
		"typecheck": "bun tsc --noEmit"
	},
	"dependencies": {
		"@nexus/contracts": "workspace:*",
		"@nexus/kernel": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.3.0",
		"chrome-types": "^0.1.327"
	}
}
